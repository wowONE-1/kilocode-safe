<!doctype html>
<html lang="ru">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Команда 3: сохранённая демонстрация</title>
<style>
@font-face{font-family:Inter;src:url(data:font/ttf;base64,{{FONT_BASE64}}) format('truetype');font-weight:100 900;font-display:swap}
:root{--paper:#f5f5fa;--ink:#111;--orange:#fa5416;--muted:#5a6470;--line:#c9cbd6}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,Arial,sans-serif}main{max-width:1320px;margin:0 auto;padding:38px 46px 28px}.brand{color:var(--orange);font-size:18px;font-weight:650;margin:0 0 17px}.title{font-size:clamp(24px,3vw,38px);font-weight:600;letter-spacing:-.04em;margin:0 0 12px;max-width:1120px}.notice{font-size:16px;color:var(--muted);line-height:1.5;max-width:1120px;margin:0 0 25px}.meta{font-size:13px;color:var(--muted);line-height:1.6;border-top:1px solid var(--line);padding-top:15px;margin:0 0 28px;overflow-wrap:anywhere}.stage{display:grid;grid-template-columns:310px minmax(0,1fr);gap:40px;min-height:420px;border-top:1px solid var(--line);padding-top:25px}.number{color:var(--orange);font-size:66px;font-weight:400;line-height:1.05;margin:0 0 17px}.stage-title{font-size:26px;line-height:1.22;letter-spacing:-.025em;margin:0 0 20px}.stage-body{font-size:18px;line-height:1.5;margin:0}.evidence-label{font-size:13px;font-weight:650;color:var(--muted);margin:0 0 10px}.evidence{border:1px solid var(--line);background:#fff;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;overflow:auto;max-height:420px;min-height:180px;margin:0;padding:22px;font-size:16px;line-height:1.5;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.observation{border-left:3px solid var(--orange);padding-left:15px;font-size:16px;line-height:1.48;margin:17px 0 0}.controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:20px;margin-top:25px}button{font:600 15px Inter,Arial,sans-serif;border:1px solid var(--line);border-radius:7px;padding:12px 17px;background:transparent;color:var(--ink);cursor:pointer}button:hover{border-color:var(--orange)}button:disabled{opacity:.35;cursor:default}button.primary{background:var(--orange);border-color:var(--orange);color:#fff}button:focus-visible{outline:3px solid #111;outline-offset:3px}.progress{font-size:14px;color:var(--muted);margin-left:auto}.fine{font-size:12px;line-height:1.6;color:var(--muted);margin:18px 0 0}.end{color:var(--orange)}@media(max-width:850px){main{padding:25px 22px}.stage{grid-template-columns:1fr;gap:22px;min-height:0}.stage-intro{display:grid;grid-template-columns:85px 1fr;gap:0 15px}.number{grid-row:1/3}.stage-title{font-size:25px}.stage-body{font-size:17px}.evidence{max-height:380px;font-size:14px}.progress{margin-left:0}}@media print{.controls,.fine{display:none}.stage{display:block}.evidence{max-height:none}.notice{color:#111}}
</style></head>
<body><main>
<p class="brand">Команда 3</p><h1 class="title" id="title"></h1><p class="notice" id="notice"></p><p class="meta" id="meta"></p>
<section class="stage" aria-live="polite" aria-atomic="true"><div class="stage-intro"><p class="number" id="number"></p><h2 class="stage-title" id="stage-title"></h2><p class="stage-body" id="stage-body"></p></div><div><p class="evidence-label" id="evidence-label"></p><pre class="evidence" id="evidence"></pre><p class="observation" id="observation"></p></div></section>
<nav class="controls" aria-label="Управление воспроизведением"><button id="prev" type="button">Назад</button><button id="play" class="primary" type="button">Воспроизвести</button><button id="next" type="button">Следующий шаг</button><button id="restart" type="button">Сначала</button><span class="progress" id="progress"></span></nav>
<p class="fine">Пробел: воспроизведение/пауза. Стрелки: предыдущий/следующий шаг. Все данные встроены в этот файл. Сеть и модели не используются, команды не исполняются. Темп показа не является временем работы агента.</p>
</main><script id="trace-data" type="application/json">{{TRACE_JSON}}</script>
<script>
'use strict';
const trace=JSON.parse(document.getElementById('trace-data').textContent);let index=0,timer=null;
const el=(id)=>document.getElementById(id);const put=(id,value)=>{el(id).textContent=value;};
put('title',trace.title);put('notice',trace.notice);const src=trace.source;put('meta',`Версия ${src.commit} · ${src.mode} · ${src.model} · ${src.date}\nСценарий ${src.case_id} · Запись ${src.run_id} · Длительность исходного прогона ${src.duration}\nИсточник: ${src.trace_path}`);
function pause(){if(timer!==null){clearInterval(timer);timer=null;}put('play',index===trace.steps.length-1?'Воспроизвести снова':'Воспроизвести');el('play').setAttribute('aria-pressed','false');}
function render(){const s=trace.steps[index];put('number',String(index+1).padStart(2,'0'));put('stage-title',s.title);put('stage-body',s.body);put('evidence-label',s.evidence_label);put('evidence',s.evidence);put('observation',s.observation);put('progress',`Шаг ${index+1} из ${trace.steps.length}`);el('prev').disabled=index===0;el('next').disabled=index===trace.steps.length-1;if(index===trace.steps.length-1)pause();}
function move(delta){index=Math.min(trace.steps.length-1,Math.max(0,index+delta));render();}
function play(){if(timer!==null){pause();return;}if(index===trace.steps.length-1){index=0;render();}put('play','Пауза');el('play').setAttribute('aria-pressed','true');timer=setInterval(()=>move(1),8000);}
el('prev').addEventListener('click',()=>{pause();move(-1)});el('next').addEventListener('click',()=>{pause();move(1)});el('play').addEventListener('click',play);el('restart').addEventListener('click',()=>{pause();index=0;render()});document.addEventListener('keydown',(event)=>{if(event.code==='Space'){event.preventDefault();play()}else if(event.code==='ArrowRight'){event.preventDefault();pause();move(1)}else if(event.code==='ArrowLeft'){event.preventDefault();pause();move(-1)}});render();
</script></body></html>
